# Sanity (только a-z, 0-9 и дефисы; без подчёркиваний)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Optional: for Sanity Studio authentication
SANITY_API_READ_TOKEN=

# URL GraphQL API (обязателен в продакшене)
# Примеры:
# NEXT_PUBLIC_API_URL=http://localhost:4000/graphql
# NEXT_PUBLIC_API_URL=https://api.2gtechlab.ru/graphql
NEXT_PUBLIC_API_URL=http://localhost:4000/graphql

# Вход через Telegram: имя бота без @ (из @BotFather)
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=MyBot
